# Sanity (required)
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2025-03-04

# Optional: Sanity Studio URL for Visual Editing
NEXT_PUBLIC_SANITY_STUDIO_URL=/studio

# Optional: Preview / draft mode tokens (viewer rights only).
# Get these from https://sanity.io/manage → API → Tokens.
SANITY_API_READ_TOKEN=

# Public site URL (used for sitemap / robots / Open Graph / canonicals).
# Production: https://utthanynr.org
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Blog host. Set this to serve the blog from its own subdomain, in which case
# posts live at the host root (blog.utthanynr.org/my-post) and canonical URLs,
# internal links, and the sitemap all follow suit.
# Production: https://blog.utthanynr.org
# Leave blank to keep the blog at /blog on the main domain.
# Local testing: http://blog.localhost:3000
NEXT_PUBLIC_BLOG_URL=

# Backend API URL (optional — only needed if a page calls the NestJS API).
NEXT_PUBLIC_API_URL=http://localhost:4000
